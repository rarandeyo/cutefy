{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "nextjs", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "prefer-const": "error",
    "no-var": "error",
    "no-unused-vars": "error",
    "eqeqeq": "error",

    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-non-null-assertion": "error",
    "typescript/array-type": ["error", { "default": "array" }],
    "typescript/consistent-type-imports": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-expect-error": { "descriptionFormat": "^: .+$" },
        "ts-nocheck": true,
        "ts-check": false
      }
    ],
    "typescript/explicit-module-boundary-types": "warn",
    "typescript/no-misused-promises": "error",

    "func-style": ["error", "expression"],
    "prefer-arrow-callback": "error",

    "node/no-process-env": "error",

    "react/react-in-jsx-scope": "off",
    "react/no-unstable-default-props": "warn",
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",

    "unicorn/no-array-for-each": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "pascalCase": true,
          "kebabCase": true
        }
      }
    ],

    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "import/no-relative-parent-imports": "warn",
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "server-only"] }
    ],

    "no-await-in-loop": "off",

    "@next/no-img-element": "off"
  },
  "overrides": [
    {
      "files": [
        "**/page.tsx",
        "**/layout.tsx",
        "**/index.tsx",
        "**/route.ts",
        "**/loading.tsx",
        "**/error.tsx",
        "**/not-found.tsx",
        "**/template.tsx",
        "**/default.tsx",
        "**/global-error.tsx"
      ],
      "rules": {
        "import/no-default-export": "off",
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["*.config.ts", "*.config.js", "*.config.mjs"],
      "rules": {
        "import/no-default-export": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/shared/lib/env/client.ts", "src/shared/lib/env/server.ts", "drizzle.config.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", ".next", "dist", "**/*.d.ts"]
}
