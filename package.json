{
  "name": "cutefy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint ./src",
    "format": "oxfmt --write ./src",
    "check": "oxlint ./src && oxfmt --check ./src && tsgo --noEmit",
    "fix": "oxlint --fix ./src && oxfmt --write ./src",
    "typecheck": "tsgo --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "@heroui/react": "3.0.0-beta.8",
    "@heroui/styles": "3.0.0-beta.8",
    "@internationalized/date": "^3.12.0",
    "@spotify/web-api-ts-sdk": "github:rarandeyo/spotify-web-api-ts-sdk",
    "@t3-oss/env-nextjs": "^0.13.10",
    "better-auth": "^1.4.17",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.4",
    "nuqs": "^2.8.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@rarandeyo/spotify-web-api-ts-sdk",
      "better-sqlite3",
      "esbuild",
      "lefthook",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@opennextjs/cloudflare": "^1.17.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260122.4",
    "better-sqlite3": "^12.10.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.73.0"
  }
}
